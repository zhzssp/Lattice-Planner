{
  "_comment": "Lattice-Agent 本地工具白名单。allowDirs 与 denyDirs 同时存在，路径必须在 allowDirs 之内且不在 denyDirs 之内才会被允许访问。请按本机实际情况修改。",
  "allowDirs": [
    "D:/notes",
    "D:/learning",
    "C:/Users/Public/Documents"
  ],
  "denyDirs": [
    "C:/Windows",
    "C:/Program Files",
    "C:/Program Files (x86)"
  ],
  "allowExt": ["md", "txt", "json", "yml", "yaml", "csv", "log", "pdf"],
  "maxFileBytes": 2097152
}
