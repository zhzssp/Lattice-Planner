<mxfile host="app.diagrams.net" modified="2026-08-20T00:00:00.000Z" agent="CodeBuddy" version="24.0.0" type="device">
  <diagram id="agent-main-loop" name="Agent主循环">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ 标题 ============ -->
        <mxCell id="title" value="Lattice-Planner 主循环（手写 ReAct）" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="480" y="20" width="640" height="40" as="geometry" />
        </mxCell>

        <!-- ============ ① 用户输入 ============ -->
        <mxCell id="start" value="用户输入 + 思维模式 mode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="90" width="480" height="50" as="geometry" />
        </mxCell>

        <!-- ============ ① 准备上下文 ============ -->
        <mxCell id="prepare" value="① 准备本轮上下文&#10;· system 前缀（缓存复用）&#10;· 可见工具视图（四层遮蔽算一次）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="180" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="start" target="prepare">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ ② 调 LLM ============ -->
        <mxCell id="llm" value="② 调用 LLM（一次一步）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="prepare" target="llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ ③ 解析 ============ -->
        <mxCell id="parse" value="③ 解析输出：是工具调用？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="390" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="llm" target="parse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ 左支：终态 → 收尾 ============ -->
        <mxCell id="finish" value="④ 收尾：询问顾问&#10;· 顾问可 steer → 回到 ②&#10;· 否则结束本轮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="390" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="否（自然语言）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;fontColor=#9673a6;" edge="1" parent="1" source="parse" target="finish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ 右支：三重闸门 ============ -->
        <mxCell id="gate" value="⑤ 三重闸门（执行前检查）&#10;a. 工具存在？ → 否则 UNKNOWN_TOOL&#10;b. 工具可见？ → 否则 TOOL_NOT_VISIBLE&#10;c. 已封禁？ → 否则 TOOL_BANNED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1120" y="380" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="是（工具调用）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;fontColor=#b85450;" edge="1" parent="1" source="parse" target="gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ ⑥ 确认 ============ -->
        <mxCell id="confirm" value="⑥ 需用户确认？&#10;是 → 弹窗，拒绝则回到 ②" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="540" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="gate" target="confirm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ ⑦ 调工具 ============ -->
        <mxCell id="invoke" value="⑦ 调用工具&#10;· 普通工具 → 直接执行&#10;· subagent.* → 开子代理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1180" y="660" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="confirm" target="invoke">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ ⑧ 回灌 ============ -->
        <mxCell id="feed" value="⑧ 结果回灌（伪装成 user）&#10;· 失败 → 注入策略提示&#10;· 降级 → 置粘性标记" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1180" y="780" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="invoke" target="feed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ 回灌 → 回到 LLM 的回边 ============ -->
        <mxCell id="loopback" value="回到 ②（下一步）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;fontColor=#82b366;dashed=1;strokeWidth=2;" edge="1" parent="1" source="feed" target="llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ steer 回边 ============ -->
        <mxCell id="steerback" value="steer 继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;fontColor=#9673a6;dashed=1;strokeWidth=2;" edge="1" parent="1" source="finish" target="llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ 闸门失败回边（三合一，简化） ============ -->
        <mxCell id="gatefail" value="闸门拦截 / 拒绝 → 回到 ②" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;fontColor=#b85450;dashed=1;strokeWidth=2;" edge="1" parent="1" source="gate" target="llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ 子代理展开框 ============ -->
        <mxCell id="subbox" value="子代理展开：subagent.plan / reflect / research" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;dashed=1;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1180" y="930" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="esub" value="入口" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;fontColor=#666666;dashed=1;" edge="1" parent="1" source="invoke" target="subbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="sub1" value="guardTopLevel()&#10;depth==0 才可委派" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1195" y="965" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub2" value="独立上下文（List，不碰主记忆）&#10;独立步数预算（6 步）&#10;独立 Reflexion 状态" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1195" y="1030" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sub3" value="压缩结论（≤4000 字符）&#10;作为工具结果回灌主循环" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1195" y="1105" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="esub12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="sub1" target="sub2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="esub23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="sub2" target="sub3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ 图例 ============ -->
        <mxCell id="legend" value="图例：绿=执行，黄=准备/回灌，橙=判断，红=闸门，紫=收尾，灰虚线框=子代理" style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1">
